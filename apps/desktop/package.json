{
  "name": "@vilamar/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:e2e": "playwright test",
    "dist": "electron-vite build && electron-builder --win --dir",
    "verificar:vertical": "playwright test --config=playwright.vertical.config.ts",
    "start": "electron out/main/index.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.116.0",
    "pdfjs-dist": "^4.9.155",
    "playwright": "^1.49.1",
    "tesseract.js": "^5.1.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vilamar/domain": "workspace:*",
    "@vilamar/extraction": "workspace:*",
    "@vilamar/integrations": "workspace:*",
    "@vilamar/report": "workspace:*",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.3.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": "^5.4.11"
  },
  "build": {
    "appId": "net.vilamar.calculator",
    "productName": "Calculator Vilamar",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Calculator Vilamar"
    }
  },
  "description": "Lee una biometría ocular una sola vez y rellena con ella las calculadoras de lente intraocular",
  "author": "Calculator Vilamar"
}
