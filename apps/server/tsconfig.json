{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    // Mismo motivo que `packages/casos`: al importar `@vilamar/integrations`
    // (Playwright `evaluate`) y `@vilamar/casos`, este proyecto también
    // necesita los tipos del DOM.
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node"]
  },
  "include": ["src/**/*.ts"]
}
